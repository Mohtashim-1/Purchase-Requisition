 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n    <html lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <title>Material Request</title>\n    \n        <style type=\"text/css\">\n            @page {\n                size: A4 landscape;\n                margin:  5mm 5mm 4mm 5mm;\n            }\n    \n            body {\n                font-family: Arial, Helvetica, sans-serif;\n                font-size: 12px;\n                margin: 0;\n                padding: 0;\n            }\n    \n            * {\n                font-size: 12px;\n            }\n    \n            .container {\n                width: 100%;\n                margin: 0 auto;\n                padding: 10px;\n            }\n    \n            table {\n                width: 100%;\n                border-collapse: collapse;\n            }\n    \n            .heading {\n                font-size: 20px;\n                font-weight: bold;\n                text-align: center;\n                color: #076ba0;\n            }\n    \n            .address-heading {\n                font-size: 15px;\n                font-weight: bold;\n            }\n    \n            .address {\n                font-size: 13px;\n            }\n    \n            .normal-content-bold-center {\n                font-size: 12px;\n                text-align: center;\n                font-weight: bold;\n            }\n    \n            .border-bottom {\n                border-bottom: solid 2px #076ba0;\n                padding-bottom: 5px;\n            }\n    \n            .watermark {\n                position: fixed;\n                top: 50%;\n                left: 50%;\n                transform: translate(-50%, -50%) rotate(-30deg);\n                font-size: 70px;\n                color: rgba(0, 0, 0, 0.07) !important;\n                z-index: -1;\n                white-space: nowrap;\n                user-select: none;\n            }\n    \n            /* Table Styling */\n            .tab2 tr:nth-child(even) {\n                background: #E8E8E8;\n            }\n    \n            .style1 {\n                font-size: 11px;\n                font-weight: bold;\n                text-align: center;\n                color: #FFF;\n            }\n    \n            .style2 {\n                font-size: 11px;\n                font-weight: bold;\n                text-align: left;\n                color: #FFF;\n            }\n    \n            .style3 {\n                font-size: 14px;\n                text-align: left;\n                font-weight: bold;\n            }\n    \n            .style4 {\n                font-size: 14px;\n                text-align: left;\n            }\n    \n            .heading-right {\n                font-size: 23px;\n                font-weight: bold;\n                text-align: right;\n                color: #076ba0;\n            }\n    \n            /* Signature Section */\n            .signature {\n                width: 100%;\n                text-align: center;\n                margin-top: 30px;\n            }\n    \n            .signature td {\n                /*border-top: 2px solid #076ba0;*/\n                padding-top: 10px;\n                font-weight: bold;\n                text-align: center;\n            }\n              /* === NEW: Totals Table Font Size Override === */\n        table.totals,\n        table.totals td {\n            font-size: 20px !important;\n            line-height: 1.2 !important;\n        }\n        \n        @media print {\n  /* force the signature container onto its own final page */\n  .signature-page {\n    page-break-before: always;\n    position: relative;         /* establish a positioning context */\n    /*height: 100vh;              */\n  }\n\n  /* then pin the table to the bottom of that page */\n  .signature-page .signature {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    width: 100%;\n  }\n}\n        </style>\n    </head>\n    <body>\n<!--     {% if doc.creation %}-->\n<!--    {% set creation_time = frappe.utils.get_datetime(doc.creation).strftime('%Y-%m-%d %H:%M') %}-->\n    \n<!--    <div class=\"watermark\" id=\"watermark\">ORIGINAL</div>-->\n\n<!--    <script>-->\n<!--        document.addEventListener(\"DOMContentLoaded\", function() {-->\n<!--            let creationTime = \"{{ creation_time }}\";-->\n<!--            let now = new Date();-->\n<!--            let currentTime = now.getFullYear() + '-' +-->\n<!--                              String(now.getMonth() + 1).padStart(2, '0') + '-' +-->\n<!--                              String(now.getDate()).padStart(2, '0') + ' ' +-->\n<!--                              String(now.getHours()).padStart(2, '0') + ':' +-->\n<!--                              String(now.getMinutes()).padStart(2, '0');-->\n\n<!--            if (creationTime !== currentTime) {-->\n<!--                document.getElementById(\"watermark\").innerText = \"DUPLICATE\";-->\n<!--            }-->\n<!--        });-->\n<!--    </script>-->\n<!--{% endif %}-->\n\n    \n        <div class=\"container\">\n            \n            \n            <!-- Header Section -->\n            <table>\n                <tr>\n                    <td class=\"border-bottom\" width=\"50%\">\n                        <span class=\"address-heading\">\n                            \n          <!--<img src=\"/files/logo_saylaniwelfare.22bf709605809177256c.png\" width=\"200px\" height=\"100px\" /> <br/>-->\n                            Saylani Medical & Diagnostic Centre</span><br>\n                        <span class=\"address\">\n                            A-25, Bahadurabad Chowrangi Karachi, Pakistan <br>\n                            UAN: 021-111-729-526 | Helpline: 92-317-3177331<br>\n                            Website: www.saylaniwelfare.com\n                        </span>\n                    </td>\n                    <td class=\"border-bottom heading-right\" width=\"50%\" style=\"font-size:30px; text-align:right;font-weight: bold;color:076ba0; font-family: Gadget, sans-serif;\">\n                        Purchase Order<br>{{ doc.name }} <br/>\n                    </td>\n                </tr>\n            </table>\n            \n            <br/>\n            \n            <!--supplier-->\n\n<table width=\"100%\" style=\"border-collapse: collapse; margin: auto; border-spacing: 0; line-height: 1;\">\n    <tr>\n        <td style=\"font-weight: bold; padding: 1px; line-height: 1;\">Posting Date</td>\n        <td style=\"padding: 1px; line-height: 1;\">{{ doc.transaction_date }}</td>\n        <td style=\"font-weight: bold; padding: 1px; line-height: 1;\">Required Date</td>\n        <td style=\"padding: 1px; line-height: 1;\">{{ doc.schedule_date }}</td>\n        \n    </tr>\n    <tr>\n        <td style=\"font-weight: bold; padding: 1px; line-height: 1;\">Supplier</td>\n        <td style=\"padding: 1px; line-height: 1;\"><strong>{{ doc.supplier }}</strong></td>\n        <td style=\"font-weight: bold; padding: 1px; line-height: 1;\">Supplier Address</td>\n        <td style=\"padding: 1px; line-height: 1;\">{{ doc.supplier_address }} {{ doc.contact_person }}</td>\n        \n    </tr>\n   \n\n    \n</table>\n\n      \n\n\n    \n            <!-- Items Table -->\n            <table border=\"1\" cellspacing=\"0\" cellpadding=\"5\">\n                <thead>\n                    <tr style=\"background: #C0C0C0; color: black;\">\n                        <th>S #</th>\n                        <th>Purchase Request</th>\n                        <th>Warehouse</th>\n                        <th>Item Name</th>\n                        <th>UOM</th>\n                        <th>Quantity</th>\n                        <th>Rate </th>\n                        <th>Gross Amount </th>\n                        <th> Discount <br/> Amount </th>\n                        <th>Discount (%)  </th>\n                        <th>Net Amount </th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% for i in doc.items %}\n                    <tr>\n                        <td style=\"width:5%\">{{ i.idx }}</td>\n                        <!--<td style=\"width:5%\">{{ i.custom_purchase_requisition }}</td>-->\n                        <td style=\"width:5%\">\n  {{ i.custom_purchase_requisition.split('-')[-1] }}\n</td>\n                        <td style=\"width:20%\">{{ i.warehouse }}</td>\n                        <td style=\"width:30%\">{{ i.item_name }}</td>\n                        <td style=\"width:5%\">{{ i.uom }}</td>\n                        <td style=\"width:5%\">\n                            <!--{{ i.qty }}-->\n                        {{ \"{:,.0f}\".format(i.qty) }}\n                        \n                        </td>\n                        <td style=\"width:5%\">\n                            <!--{{ i.rate }}-->\n                            <!--{{ \"{:,.2f}\".format(i.rate) }}-->\n                             {{ (\"{:.10f}\".format(i.rate))[:5] }}\n                            \n\n                        </td>\n                        \n                        <td style=\"width:5%\">\n                            <!--{{ i.custom_gross_rate }}-->\n                            <!--{{ \"{:,.2f}\".format(i.custom_gross_rate) }}-->\n                             <!--{{ (\"{:.10f}\".format(i.custom_gross_rate))[:5] }}-->\n                              <!--{{ i.custom_gross_rate | int }}-->\n                              \n                            {{ \"{:,.0f}\".format(i.custom_gross_rate) }} \n\n                        </td>\n                        <td style=\"width:5%\">\n                            <!--{{ i.custom_discounted_amount }}-->\n                            <!--{{ \"{:,.2f}\".format(i.custom_discounted_amount) }}-->\n                             <!--{{ (\"{:.10f}\".format(i.custom_discounted_amount))[:5] }}-->\n                             {{ i.custom_discounted_amount | int }}\n                            </td>\n                        <td style=\"width:5%\">\n                            <!--{{ i.custom_discount_ }}-->\n                            {{ \"{:,.0f}\".format(i.custom_discount_) }} %\n                            </td>\n                        <td style=\"width:5%\">\n                            <!--{{ i.amount }}-->\n                            <!--{{ \"{:,.2f}\".format(i.amount) }}-->\n                            <!--{{ (\"{:.10f}\".format(i.amount))[:5] }}-->\n                            <!--{{ i.amount | int }}-->\n                            \n                            {{ \"{:,.0f}\".format(i.amount) }} \n\n                            </td>\n                    </tr>\n                    {% endfor %}\n                </tbody>\n            </table>\n    \n            <br/>\n            \n            \n              <br/>\n    \n    \n     <!-- Items Table -->\n           {% if doc.taxes %}\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"5\" style=\"table-layout: fixed; width:100%\">\n    <colgroup>\n        <col style=\"width:5%\">\n        <col style=\"width:75%\">\n        <col style=\"width:10%\">\n        <col style=\"width:10%\">\n    </colgroup>\n    <thead>\n        <tr style=\"background: #C0C0C0; color: black;\">\n            <th style=\"text-align:center;\">S #</th>\n            <th style=\"text-align:left;\">Account Head</th>\n            <th style=\"text-align:right;\">Rate</th>\n            <th style=\"text-align:right;\">Amount</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for i in doc.taxes %}\n        <tr>\n            <td style=\"text-align:center;\">{{ i.idx }}</td>\n            <td style=\"text-align:left;\">{{ i.account_head }}</td>\n            <td style=\"text-align:right;\">{{ i.rate }}</td>\n            <td style=\"text-align:right;\">{{ \"{:,.0f}\".format(i.tax_amount) }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n{% endif %}\n \n    \n<!-- Signature Section -->\n<table style=\"width: 100%; border-collapse: collapse; border-spacing: 0; line-height: 1;\">\n  <tr>\n    <!-- Left Side: Terms & Conditions -->\n    <td style=\"width: 55%; vertical-align: top; padding: 2px;\">\n      <strong>Terms & Conditions:</strong><br/>\n\n      {% if doc.terms %}\n        {{ doc.terms }}\n      {% endif %}\n      PAYMENT WITHIN 30 WORKING DAYS AFTER DELIVERY.\n    </td>\n\n    <!-- Right Side: Totals -->\n    <td style=\"width: 45%; vertical-align: top; padding: 2px;\">\n      <table style=\"width: 100%; border-collapse: collapse; border-spacing: 0;\">\n        <tr style=\"line-height: 0.5;\">\n          <td style=\"width: 50%; text-align: left; padding: 1px 2px; font-size: 13px;\"><strong>Total Qty</strong></td>\n          <td style=\"width: 50%; text-align: left; padding: 1px 2px; font-size: 15px; font-weight: bold;\">\n            {{ \"{:,.0f}\".format(doc.total_qty) }}\n          </td>\n        </tr>\n        <tr style=\"line-height: 0.5;\">\n          <td style=\"width: 50%; text-align: left; padding: 1px 2px; font-size: 13px;\"><strong>Gross Total</strong></td>\n          <td style=\"width: 50%; text-align: left; padding: 1px 2px; font-size: 15px; font-weight: bold;\">\n            {{ \"{:,.0f}\".format(doc.custom_gross_rate) }}\n          </td>\n        </tr>\n        <tr style=\"line-height: 0.5;\">\n          <td style=\"width: 50%; text-align: left; padding: 1px 2px; font-size: 13px;\"><strong>Discounted Amount</strong></td>\n          <td style=\"width: 50%; text-align: left; padding: 1px 2px; font-size: 15px; font-weight: bold;\">\n            {{ \"{:,.0f}\".format(doc.custom_discounted_amount) }}\n          </td>\n        </tr>\n        <tr style=\"line-height: 0.5;\">\n          <td style=\"width: 50%; text-align: left; padding: 1px 2px; font-size: 13px;\"><strong>Discounted (%)</strong></td>\n          <td style=\"width: 50%; text-align: left; padding: 1px 2px; font-size: 15px; font-weight: bold;\">\n            {{ \"{:,.0f}\".format(doc.custom_discounted_percentage) }} %\n          </td>\n        </tr>\n        {% for i in doc.taxes %}\n        <tr style=\"line-height: 0.5;\">\n          <td style=\"width: 50%; text-align: left; padding: 1px 2px; font-size: 13px;\"><strong>{{ i.account_head }}</strong></td>\n          <td style=\"width: 50%; text-align: left; padding: 1px 2px; font-size: 15px; font-weight: bold;\">\n            {{ \"{:,.0f}\".format(i.tax_amount) }}\n          </td>\n        </tr>\n        {% endfor %}\n        <tr style=\"line-height: 0.5;\">\n          <td style=\"width: 50%; text-align: left; padding: 1px 2px; font-size: 13px;\"><strong>Net Total</strong></td>\n          <td style=\"width: 50%; text-align: left; padding: 1px 2px; font-size: 15px; font-weight: bold; color: #000;\">\n            {{ \"{:,.0f}\".format((doc.custom_net_rate or 0) + (doc.total_taxes_and_charges or 0)) }}\n          </td>\n        </tr>\n        \n        <tr style=\"line-height: 0.5;\">\n          <td style=\"text-align: left; padding: 1px 2px; font-size: 13px;\"><strong>In Words (PKR)</strong></td>\n          <td style=\"text-align: left; padding: 1px 2px; font-size: 12px; line-height: 1;\">\n            <strong>{{ frappe.utils.money_in_words((doc.custom_net_rate or 0) + (doc.total_taxes_and_charges or 0), doc.currency or \"PKR\") }}</strong>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n</table>\n\n\n\n <br/>\n  <br/>\n   <br/>\n     \n     \n \n\n    \n        </div>\n        \n<div class=\"signature-page\">\n  <table\n    class=\"signature\"\n    style=\"\n      width: 100%;\n      border-collapse: separate !important;\n      border-spacing: 20px 0 !important;\n      table-layout: fixed;\n    \"\n  >\n    <tr>\n      <!-- 1st: Prepared By -->\n      <td\n        class=\"normal-content-bold-center\"\n        style=\"\n          width: 20%;\n          border-top: 2px solid #076ba0;\n          padding: 15px 10px 5px;\n          vertical-align: bottom;\n          line-height: 1.4;\n        \"\n      >\n        Prepared By<br>\n        {{ frappe.get_fullname(doc.owner) }}<br>\n        {{ doc.get_formatted('creation') }}\n      </td>\n\n      <!-- 2nd: Supply Chain Manager -->\n      <td\n        class=\"normal-content-bold-center\"\n        style=\"\n          width: 20%;\n          border-top: 2px solid #076ba0;\n          padding: 15px 10px 5px;\n          vertical-align: bottom;\n          line-height: 1.4;\n        \"\n      >\n        Supply Chain<br>Manager\n      </td>\n\n      <!-- 3rd: Head of Department -->\n      <td\n        class=\"normal-content-bold-center\"\n        style=\"\n          width: 20%;\n          border-top: 2px solid #076ba0;\n          padding: 15px 10px 5px;\n          vertical-align: bottom;\n          line-height: 1.4;\n        \"\n      >\n        Head of<br>Department\n      </td>\n\n      <!-- 4th: Managing Committee Member -->\n      <td\n        class=\"normal-content-bold-center\"\n        style=\"\n          width: 20%;\n          border-top: 2px solid #076ba0;\n          padding: 15px 10px 5px;\n          vertical-align: bottom;\n          line-height: 1.4;\n        \"\n      >\n        Managing<br>Committee<br>Member\n      </td>\n\n      <!-- 5th: Trustee -->\n      <td\n        class=\"normal-content-bold-center\"\n        style=\"\n          width: 20%;\n          border-top: 2px solid #076ba0;\n          padding: 15px 10px 5px;\n          vertical-align: bottom;\n          line-height: 1.4;\n        \"\n      >\n        Trustee\n      </td>\n    </tr>\n  </table>\n</div>\n\n    </body>\n    </html>",
